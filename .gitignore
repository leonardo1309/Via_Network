# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env

# Local firmware secrets/config
firmware/src/config.h

# PlatformIO build artifacts and vendored libdeps
firmware/.pio/
firmware/compile_commands.json

# Relayer (Node/TypeScript)
relayer/node_modules/
relayer/dist/

# Local Claude Code skill symlink — points to an absolute machine-specific path;
# the real content is committed under .agents/skills/, this just gets regenerated locally.
.claude/
