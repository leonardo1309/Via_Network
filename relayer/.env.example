# Relayer config — copy to .env (gitignored) and fill in real values.

# Wallet that pays gas. Needs a balance in FEE_CURRENCY_ADDRESS (not native CELO).
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY

# "sepolia" (Celo Sepolia testnet, chain 11142220) or "mainnet" (Celo, chain 42220)
CHAIN=sepolia
RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# Deployed VIA_Operator address (from `forge script script/Deploy.s.sol`)
OPERATOR_ADDRESS=0xYOUR_DEPLOYED_OPERATOR_ADDRESS

# feeCurrency to pay gas with. USDm on Celo Sepolia (verified on-chain):
# 0xdE9e4C3ce781b4bA68120d6261cbad65ce0aB00b
# USDm on Celo Mainnet: 0x765DE816845861e75A25fCA122bb6898B8B1282a
# Double-check this is still on the network's FeeCurrencyDirectory allowlist before relying on it.
FEE_CURRENCY_ADDRESS=0xdE9e4C3ce781b4bA68120d6261cbad65ce0aB00b

PORT=3001
