{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: Build",
      "type": "shell",
      "command": "python",
      "args": ["-m", "platformio", "run"],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Firmware: Upload",
      "type": "shell",
      "command": "python",
      "args": ["-m", "platformio", "run", "-t", "upload"],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Firmware: Monitor",
      "type": "shell",
      "command": "python",
      "args": ["-m", "platformio", "device", "monitor", "-b", "115200"],
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Firmware: Build + Upload",
      "dependsOrder": "sequence",
      "dependsOn": ["Firmware: Build", "Firmware: Upload"],
      "problemMatcher": []
    },
    {
      "label": "Firmware: Upload + Monitor",
      "type": "shell",
      "command": "python -m platformio run -t upload; python -m platformio device monitor -b 115200",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": []
    }
  ]
}
